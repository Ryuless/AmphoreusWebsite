rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn() && (
        request.auth.token.role == role ||
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == role
      );
    }

    function staff() {
      return signedIn() && request.auth.token.role in ['Primodial', 'Titan', 'Olimpus', 'Demigod'];
    }

    match /members/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn() && (request.auth.uid == userId || staff());
      allow update: if signedIn() && (
        hasRole('Primodial') ||
        (request.auth.uid == userId && request.resource.data.role == resource.data.role)
      );
      allow delete: if hasRole('Primodial');
    }

    match /site/{document} {
      allow read: if true;
      allow write: if hasRole('Primodial');
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if hasRole('Primodial') || hasRole('Titan') || hasRole('Demigod');
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if hasRole('Primodial') || hasRole('Titan') || hasRole('Demigod');
    }

    match /justiceReports/{reportId} {
      allow read, write: if hasRole('Primodial') || hasRole('Olimpus');
    }
  }
}
